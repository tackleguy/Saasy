# AURA environment variables. Copy to .env.local for local work; add the same
# names in Vercel → Project → Settings → Environment Variables for production.
# Never prefix a secret with NEXT_PUBLIC_.

# --- Local AI assistant ("Ask AURA") ----------------------------------------
# Runs on a model on your own machine; nothing is sent to the cloud.
# OLLAMA_URL=http://127.0.0.1:11434
# AURA_AI_MODEL=llama3.2:latest
# LMSTUDIO_URL=http://127.0.0.1:1234
# LMSTUDIO_MODEL=
# AURA_LOCAL_AI=1                          # probe local model URLs even on Vercel
# AURA_ASSISTANT_RATE_LIMIT=20             # chat messages per IP per 10 minutes
# AURA_ENGINE_RATE_LIMIT=10                # blueprint vision reads per IP per 10 minutes
# AURA_ALLOWED_ORIGINS=https://aura.example.com   # extra origins allowed to call the APIs

# --- Supabase (accounts, customer projects, share links) ---------------------
# See docs/SUPABASE-SETUP.md. Without these the site runs on the built-in samples.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=           # or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=               # or SUPABASE_SECRET_KEY — server only, secret
# NEXT_PUBLIC_SITE_URL=https://aura.example.com

# --- Enquiry / early-access email (Resend) ----------------------------------
# RESEND_API_KEY=
# AURA_ENQUIRY_TO=sales@example.com
# AURA_ENQUIRY_FROM=AURA <hello@example.com>

# --- Map services (optional) -------------------------------------------------
# AURA_OVERPASS_URL=https://overpass-api.de/api/interpreter
# AURA_GEOCODER_URL=https://nominatim.openstreetmap.org/search
