# AURA environment variables. Copy to .env.local for local work; add the same
# names in Vercel → Project → Settings → Environment Variables for production.
# Never prefix a secret with NEXT_PUBLIC_.

# --- AI assistant ("Ask AURA") and blueprint reading (/engine) ---------------
# Required for the assistant on the live site. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional overrides
# AURA_ASSISTANT_MODEL=claude-opus-5-5     # chat model
# AURA_ENGINE_MODEL=claude-sonnet-5-5      # blueprint/PDF vision model
# AURA_ASSISTANT_RATE_LIMIT=20             # chat messages per IP per 10 minutes
# AURA_ENGINE_RATE_LIMIT=10                # vision reads per IP per 10 minutes
# AURA_ALLOWED_ORIGINS=https://aura.example.com   # extra origins allowed to call the APIs (comma separated)

# Local models (development only; ignored in production unless AURA_LOCAL_AI=1)
# OLLAMA_URL=http://127.0.0.1:11434
# AURA_AI_MODEL=llama3.2:latest
# LMSTUDIO_URL=http://127.0.0.1:1234
# LMSTUDIO_MODEL=
# AURA_LOCAL_AI=1
