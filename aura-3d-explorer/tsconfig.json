{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-qa-phase1/types/**/*.ts",
    ".next-qa-phase1/dev/types/**/*.ts",
    ".next-local/types/**/*.ts",
    ".next-local/dev/types/**/*.ts",
    ".next-qa-skyline/types/**/*.ts",
    ".next-qa-skyline/dev/types/**/*.ts",
    ".next-qa-skyline-build/types/**/*.ts",
    ".next-qa-skyline-build/dev/types/**/*.ts",
    ".next-qa-focused/types/**/*.ts",
    ".next-qa-focused/dev/types/**/*.ts",
    ".next-qa-focused-production/types/**/*.ts",
    ".next-qa-focused-production/dev/types/**/*.ts",
    ".next-qa-district/types/**/*.ts",
    ".next-qa-district/dev/types/**/*.ts",
    ".next-qa-district-final/types/**/*.ts",
    ".next-qa-district-final/dev/types/**/*.ts",
    ".next-qa-mapped/types/**/*.ts",
    ".next-qa-mapped/dev/types/**/*.ts",
    ".next-qa-mapped-final/types/**/*.ts",
    ".next-qa-mapped-final/dev/types/**/*.ts",
    ".next-qa-map-ship/types/**/*.ts",
    ".next-qa-map-ship/dev/types/**/*.ts",
    ".next-qa-map-verified/types/**/*.ts",
    ".next-qa-map-verified/dev/types/**/*.ts",
    ".next-sales-gallery/types/**/*.ts",
    ".next-sales-gallery/dev/types/**/*.ts",
    ".next-skyline-detail/types/**/*.ts",
    ".next-skyline-detail/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
